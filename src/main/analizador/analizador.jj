
PARSER_BEGIN(Heroa)
import java.io.*;

public class Heroa {
    public static void main(String[] args){
      try{
          InputStream input = new FileInputStream("prueba.txt");
          Heroa analizador = new Heroa(input);

          // Llamamos a la regla sintáctica principal (Unidad 5)
          analizador.Principal();

          System.out.println("Análisis Sintáctico terminado con éxito.");
      } catch (FileNotFoundException e){
          System.out.println("Error: El archivo 'prueba.txt' no existe.");
      } catch (ParseException e){ // Error de sintaxis (Unidad 5.9)
          System.err.println("Error Sintáctico: " + e.getMessage());
      } catch (TokenMgrError e){ // Error léxico (Unidad 4.4)
          System.err.println("Error Léxico detectado: " + e.getMessage());
      }
    }
}
PARSER_END(Heroa)

SKIP : {" "|"\r"|"\t"|"\n"}
TOKEN :{
    //Identificadores
    <IDENTIFICADOR: <MINUSCULA> (<RESTO_IDENTIFICADOR>)*> |
    <#MINUSCULA: ["a"-"z"]> |
    <#MAYUSCULA: ["A"-"Z"]> |
    <#DIGITO: ["0"-"9"]> |
    <#LETRA: <MINUSCULA> | <MAYUSCULA> > |
    <#CARACTER: <LETRA> | <DIGITO> > |
    <#RESTO_IDENTIFICADOR: ("_")? <CARACTER> > |
    //Tipos de Dato
    <ENTERO: "entero"> |
    <DECIMAL: "decimal"> |
    <CHAR: "caracter"> |
    <BOOLEANO: "booleano"> |
    <CADENA: "cadena"> |
    //Operadores Aritmeticos
    <SUMA: "+"> |
    <RESTA: "-"> |
    <MULTIPLICACION: "*"> |
    <DIVISION: "/"> |
    <MODULO: "%"> |
    <POTENCIA: "**">|
    //Operadores Relacionales
    <IGUAL_QUE: "=="> |
    <DIFERENTE_DE: "=!"> |
    <MAYOR_QUE: ">"> |
    <MENOR_QUE: "<"> |
    <MAYOR_IGUAL: ">="> |
    <MENOR_IGUAL: "<="> |
    //Operadores logicos
    <AND: "&&"> |
    <NOT: "!"> |
    <OR: "|||"> |
    //Operadores de asignacion
    <ASIGNACION: "="> |
    <ASIGNACION_SUMA: "=+"> |
    <ASIGNACION_RESTA: "=-"> |
    <ASIGNACION_MULTIPLICACION: "=*"> |
    <ASIGNACION_DIVISION: "=/"> |
    //Declaracion de variables
    <VARIABLE: "variable"> |
    <DELIMITADOR: ";"> |
    <COMA: ","> |
    <VALOR_CADENA: "\"" (~["\""])* "\""> |
    <VALOR_NUMERO: (["0"-"9"])+("."(["0"-"9"])+)?>
}

void Principal():{}{
    (Declaracion() )* <EOF>
}
void Declaracion():{}{
    LOOKAHEAD(3)
    DeclaracionAsignacion()  | DeclaracionSimple() | DeclaracionMultiple()
}

void DeclaracionSimple():{}{
    <VARIABLE> TipoDato() <IDENTIFICADOR> <DELIMITADOR>
    {System.out.println("Sintaxis Correcta: Declaracion Simple");}
}

void DeclaracionAsignacion():{}{
    <VARIABLE> TipoDato() <IDENTIFICADOR> <ASIGNACION> ValorVariable() <DELIMITADOR>
    {System.out.println("Sintaxis Correcta: Declaracion con Asignacion");}
}

void DeclaracionMultiple():{}{
    <VARIABLE> TipoDato() <IDENTIFICADOR> <COMA> <IDENTIFICADOR> (<COMA> <IDENTIFICADOR> )* <DELIMITADOR>
    {System.out.println("Sintaxis Correcta: Declaracion Multiple");}
}

void TipoDato():{}{
    <ENTERO> |<DECIMAL> |<CHAR> |<BOOLEANO> | <CADENA>
}

void ValorVariable():{}{
    <VALOR_CADENA> | <VALOR_NUMERO>
}
